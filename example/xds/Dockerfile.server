# Dockerfile for xDS example server

FROM golang:1.21-alpine AS builder

WORKDIR /build

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the server
RUN cd example/xds/server && \
    CGO_ENABLED=0 GOOS=linux go build -o /app/server main.go

# Final stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates

WORKDIR /app

# Copy binary and config
COPY --from=builder /app/server .
COPY example/xds/server/config.yaml .

# Expose port
EXPOSE 8080

# Run the server
CMD ["./server"]
