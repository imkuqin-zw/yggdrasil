# Dockerfile for xDS example client

FROM golang:1.21-alpine AS builder

WORKDIR /build

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the client
RUN cd example/xds/client && \
    CGO_ENABLED=0 GOOS=linux go build -o /app/client main.go

# Final stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates

WORKDIR /app

# Copy binary and config
COPY --from=builder /app/client .
COPY example/xds/client/config.yaml .

# Run the client
CMD ["./client"]
